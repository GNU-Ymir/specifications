use std::io;

/**
 * Tell whether three cells hold the same letter.
 *
 * @params:
 *    - a, b, c: the three cells
 * @returns: their letter if it is the same, nothing if not or if they are empty
 */
fn line(a: c8, b: c8, c: c8)-> c8? {
  if a != '.' && a == b && b == c {
    a?
  } else {
    none
  }
}

/**
 * Find the winner of a game of tic-tac-toe.
 *
 * @params:
 *    - board: the grid of 3 rows of 3 cells
 * @returns: the letter of the winner, nothing if there is none
 */
fn winner(board: [[c8 ; 3] ; 3])-> c8? {
  for i in 0 .. 3 {
    if let Ok(p) = line(board[i][0], board[i][1], board[i][2]) {
      return p?;
    }
    if let Ok(p) = line(board[0][i], board[1][i], board[2][i]) {
      return p?;
    }
  }
  if let Ok(p) = line(board[0][0], board[1][1], board[2][2]) {
    return p?;
  }
  line(board[0][2], board[1][1], board[2][0])
}

/**
 * Print a board and its winner.
 *
 * @params:
 *    - board: the grid of 3 rows of 3 cells
 */
fn show(board: [[c8 ; 3] ; 3]) {
  for row in board {
    for cell in row {
      print(cell, " ");
    }
    println();
  }
  match winner(board) {
    Ok(p) => println(p, " wins.");
    Err() => println("No winner.");
  }
  println();
}

fn main() {
  show([['X', 'O', 'X'],
        ['O', 'X', 'O'],
        ['.', 'O', 'X']]);
  show([['O', 'X', '.'],
        ['O', 'X', 'X'],
        ['O', '.', '.']]);
  show([['X', 'O', 'X'],
        ['X', 'O', 'O'],
        ['O', 'X', 'X']]);
}
