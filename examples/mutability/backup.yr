use std::io;

fn discount(dmut prices: [i32], percent: i32) {
  for i in 0 .. prices.len {
    prices[i] = prices[i] * (100 - percent) / 100;
  }
}

fn main() {
  let dmut prices = copy [120, 80, 45];
  let seen = prices;
  let before = copy prices;
  discount(alias prices, 10);
  println("Now:    ", prices);
  println("Seen:   ", seen);
  println("Before: ", before);
}
